POSTGRES_DB=qcm_app
POSTGRES_USER=qcm_user
POSTGRES_PASSWORD=replace-with-local-postgres-password
JWT_SECRET_KEY=replace-with-one-shared-long-random-secret

AUTH_DB_SCHEMA=auth
AUTH_ENABLE_DEFAULT_ADMIN=true
AUTH_DEFAULT_ADMIN_EMAIL=admin@example.com
AUTH_DEFAULT_ADMIN_PASSWORD=replace-with-local-admin-password
AUTH_DEFAULT_ADMIN_FULL_NAME=Admin Iktibar

USER_DB_SCHEMA=users

DOCUMENT_DB_SCHEMA=documents
DOCUMENT_STORAGE_ROOT=/app/storage

KNOWLEDGE_DB_SCHEMA=knowledge
KNOWLEDGE_DOCUMENT_SERVICE_URL=http://document-service:8000
KNOWLEDGE_VECTOR_STORE_ROOT=/app/vector_store
KNOWLEDGE_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

AI_DB_SCHEMA=ai
AI_KNOWLEDGE_SERVICE_URL=http://knowledge-service:8000
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=The QCM App
OPENROUTER_HTTP_REFERER=http://localhost:8005

GENERATION_DB_SCHEMA=generation
GENERATION_AI_SERVICE_URL=http://ai-service:8000
GENERATION_LEARNING_SERVICE_URL=http://learning-service:8000
LEARNING_SERVICE_URL=http://learning-service:8000

EVALUATION_DB_SCHEMA=evaluation

LEARNING_DB_SCHEMA=learning
LEARNING_EVALUATION_SERVICE_URL=http://evaluation-service:8000
EVALUATION_SERVICE_URL=http://evaluation-service:8000
LEARNING_VECTOR_STORE_ROOT=/app/vector_store
LEARNING_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

EXPORT_DB_SCHEMA=export
EXPORT_GENERATION_SERVICE_URL=http://generation-service:8000
EXPORT_DOCUMENT_SERVICE_URL=http://document-service:8000
EXPORT_STORAGE_ROOT=/app/storage
EXPORT_DIR_NAME=exports

VITE_AUTH_SERVICE_URL=http://localhost:8001
VITE_USER_SERVICE_URL=http://localhost:8002
VITE_DOCUMENT_SERVICE_URL=http://localhost:8003
VITE_KNOWLEDGE_SERVICE_URL=http://localhost:8004
VITE_AI_SERVICE_URL=http://localhost:8005
VITE_GENERATION_SERVICE_URL=http://localhost:8006
VITE_EVALUATION_SERVICE_URL=http://localhost:8007
VITE_LEARNING_SERVICE_URL=http://localhost:8008
VITE_EXPORT_SERVICE_URL=http://localhost:8009
